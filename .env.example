# Server-side only. Set these in Vercel → Project → Settings → Environment Variables.
# Without GROQ_API_KEY the app still works in rule-based mode.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_SPEECH_MODEL=whisper-large-v3
# Optional: extra origins allowed to call /api (comma-separated), e.g. a custom domain
ALLOWED_ORIGINS=
